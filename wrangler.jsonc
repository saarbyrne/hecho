{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hecho",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "hecho.fyi", "custom_domain": true }
  ],
  "kv_namespaces": [
    { "binding": "SIGNUPS", "id": "85fe001e457e48698792385588bf9526" }
  ],
  // Sends each sign-up to NOTIFY_TO. Free while NOTIFY_TO is a verified address in Email Routing.
  "send_email": [
    { "name": "NOTIFY" }
  ],
  "vars": {
    "STRIPE_URL": "https://buy.stripe.com/00w14ffEN11ve864p57g400",
    "NOTIFY_FROM": "hola@hecho.fyi",
    "NOTIFY_TO": "byrne.saar@gmail.com",
    // Gemini models, as named on ai.google.dev/gemini-api/docs/pricing on 9 Oct 2026. The key is the secret GEMINI_API_KEY.
    "GEMINI_LIVE_MODEL": "gemini-3.8-live",
    "GEMINI_TEXT_MODEL": "gemini-3.8-flash"
  },
  // Leer: refresh one news feed every 15 minutes (see src/leer/).
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true },
  // Accounts and other personal data: one D1 database, created in the EU (see migrations/).
  "d1_databases": [
    { "binding": "DB", "database_name": "hecho", "database_id": "e03d39fb-ac5d-4436-af7a-fc098cf17c7d", "migrations_dir": "migrations" }
  ]
}
